                OUT_DIR
                + "sWGS_fitting/{project}_{bin}kb/absolute_POST_down_sampling/{sample}/abs_cn_rds/{project}_{sample}_{bin}kb_ds_abs_fits.tsv",
                sample=SAMPLES,
                project=config["project_name"],
